class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">suggestionMode</span> : <a href=\"./Lean/Elab/DocString.html#Lean.Doc.SuggestionMode\">SuggestionMode</a> := <a href=\"./Lean/Elab/DocString.html#Lean.Doc.SuggestionMode.interactive\">SuggestionMode.interactive</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Term/TermElabM.html#Lean.Elab.Term.TermElabM\">Elab.TermElabM</a> (<span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/DocString/DeferredCheck.html#Lean.Doc.DeferredCheck\">DeferredCheck</a></span>)</span></div></div>","info":{"doc":"Runs a documentation elaborator in a declaration's context, discarding changes made to the\nenvironment.","docLink":"./Lean/Elab/DocString.html#Lean.Doc.DocM.exec","kind":"def","line":227,"name":"Lean.Doc.DocM.exec","sourceLink":"https://github.com/leanprover/lean4/blob/b35cb10cf2ced51a2fd1880cfdbf75c71ab7a35a/src/Lean/Elab/DocString.lean#L227-L320"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Elab/DocString.html#Lean.Doc.DocM.execForModule\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">DocM</span>.<span class=\"name\">execForModule</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">α</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">act</span> : <span class=\"fn\"><a href=\"./Lean/Elab/DocString.html#Lean.Doc.DocM\">DocM</a> <span class=\"fn\">α</span></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">suggestionMode</span> : <a href=\"./Lean/Elab/DocString.html#Lean.Doc.SuggestionMode\">SuggestionMode</a> := <a href=\"./Lean/Elab/DocString.html#Lean.Doc.SuggestionMode.interactive\">SuggestionMode.interactive</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/Term/TermElabM.html#Lean.Elab.Term.TermElabM\">Elab.TermElabM</a> (<span class=\"fn\">α</span> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Lean/DocString/DeferredCheck.html#Lean.Doc.DeferredCheck\">DeferredCheck</a></span>)</span></div></div>","info":{"doc":"Runs a documentation elaborator in a suitable context for module docstrings. Terms in the docstring\nare elaborated with the `open` declarations, local context, local instances, and options of the\ncurrent scope, while Lean commands in code blocks run in a fresh top-level scope. Changes made to\nthe environment are discarded.","docLink":"./Lean/Elab/DocString.html#Lean.Doc.DocM.execForModule","kind":"def","line":207,"name":"Lean.Doc.DocM.execForModule","sourceLink":"https://github.com/leanprover/lean4/blob/b35cb10cf2ced51a2fd1880cfdbf75c71ab7a35a/src/Lean/Elab/DocString.lean#L207-L224"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Elab/DocString.html#Lean.Doc.addDeferredCheck\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">addDeferredCheck</span></a> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">check</span> : <a href=\"./Init/Dynamic.html#Dynamic\">Dynamic</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">imports</span> : <span class=\"fn\"><a href=\"./Init/Prelude.html#Array\">Array</a> <a href=\"./Init/Prelude.html#Lean.Name\">Name</a></span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">ref</span> : <a href=\"./Init/Prelude.html#Lean.Syntax\">Syntax</a>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Lean/Elab/DocString.html#Lean.Doc.DocM\">DocM</a> <a href=\"./Init/Prelude.html#Nat\">Nat</a></span></div></div>","info":{"doc":"Records a deferred check. Deferred checks represent a docstring task that can't be carried out at\nthe elaboration site, such as resolving a forward reference. Recorded checks include the current\nnamespace, open namespaces, and options, but not the local context.\n\nThe origin site `ref` is used to record the origin of the deferred check. Returns the check's index\nwithin the current docstring, which the docstring's AST stores to refer back to it.\n\nThe saved deferred check is not associated with the docstring or module doc until it is actually\nadded to the environment. After this call, the internal state stores `Name.anonymous`.","docLink":"./Lean/Elab/DocString.html#Lean.Doc.addDeferredCheck","kind":"def","line":146,"name":"Lean.Doc.addDeferredCheck","sourceLink":"https://github.com/leanprover/lean4/blob/b35cb10cf2ced51a2fd1880cfdbf75c71ab7a35a/src/Lean/Elab/DocString.lean#L146-L175"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./Lean/Elab/DocString.html#Lean.Doc.instMonadLiftTermElabMDocM\"><span class=\"name\">Lean</span>.<span class=\"name\">Doc</span>.<span class=\"name\">instMonadLiftTermElabMDocM</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Prelude.html#MonadLift\">MonadLift</a> <a href=\"./Lean/Elab/Term/TermElabM.html#Lean.Elab.Term.TermElabM\">Elab.TermElabM</a> <a href=\"./Lean/Elab/DocString.html#Lean.Doc.DocM\">DocM</a></span></div></div>","info":{"doc":"","docLink":"./Lean/Elab/DocString.html#Lean.Doc.instMonadLiftTermElabMDocM","kind":"instance","line":137,"name":"Lean.Doc.instMonadLiftTermElabMDocM","sourceLink":"https://github.com/leanprover/lean4/blob/b35cb10c