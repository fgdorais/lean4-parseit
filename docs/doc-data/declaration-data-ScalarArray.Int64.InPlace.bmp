`.","docLink":"./ScalarArray/Int64/InPlace.html#ScalarArray.Int64Array.Slice.foldlInPlaceThen","kind":"def","line":824,"name":"ScalarArray.Int64Array.Slice.foldlInPlaceThen","sourceLink":"https://github.com/fgdorais/lean4-scalar-arrays/blob/ef15f198ef3e5fefe3f9b45b89a25772f75b1809/ScalarArray/Int64/InPlace.lean#L824-L835"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">theorem</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./ScalarArray/Int64/InPlace.html#ScalarArray.Int64Array.Slice.foldrInPlace_eq_foldr_finRange\"><span class=\"name\">ScalarArray</span>.<span class=\"name\">Int64Array</span>.<span class=\"name\">Slice</span>.<span class=\"name\">foldrInPlace_eq_foldr_finRange</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">β</span> : <a href=\"./foundational_types.html\">Type</a> v}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">s</span> : <a href=\"./ScalarArray/Int64/Slice.html#ScalarArray.Int64Array.Slice\">Int64Array.Slice</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">init</span> : <span class=\"fn\">β</span>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">f</span> : <span class=\"fn\">(<span class=\"fn\">k</span> : <a href=\"./Init/Prelude.html#USize\">USize</a>) → <span class=\"fn\"><span class=\"fn\"><span class=\"fn\">k</span>.<a href=\"./Init/Data/UInt/BasicAux.html#USize.toNat\">toNat</a></span> <a href=\"./Init/Prelude.html#LT.lt\">&lt;</a> <span class=\"fn\"><a href=\"./Init/Data/Slice/Operations.html#Std.Slice.size\">Std.Slice.size</a> <span class=\"fn\">s</span></span> → <span class=\"fn\"><a href=\"./Init/Data/SInt/Basic.html#Int64\">Int64</a> → <span class=\"fn\"><span class=\"fn\">β</span> → <a href=\"./Init/Data/SInt/Basic.html#Int64\">Int64</a> <a href=\"./Init/Prelude.html#Prod\">×</a> <span class=\"fn\">β</span></span></span></span></span>)<