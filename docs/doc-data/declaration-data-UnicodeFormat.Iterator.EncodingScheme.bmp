heme.html#Unicode.EncodingScheme.decodeIter\"><span class=\"name\">Unicode</span>.<span class=\"name\">EncodingScheme</span>.<span class=\"name\">decodeIter</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">ι</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Data/Iterators/Basic.html#Std.Iterator\">Std.Iterator</a> <span class=\"fn\">ι</span> <a href=\"./Init/Control/Id.html#Id\">Id</a> <a href=\"./Init/Prelude.html#UInt8\">UInt8</a></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Data/Iterators/Basic.html#Std.Iterators.Productive\">Std.Iterators.Productive</a> <span class=\"fn\">ι</span> <a href=\"./Init/Control/Id.html#Id\">Id</a></span>]</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./UnicodeFormat/EncodingScheme.html#Unicode.EncodingScheme\">EncodingScheme</a>)</span></span> <span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">it</span> : <span class=\"fn\"><a href=\"./Init/Data/Iterators/Basic.html#Std.Iter\">Std.Iter</a> <a href=\"./Init/Prelude.html#UInt8\">UInt8</a></span>)</span></span> <span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./Init/Data/Iterators/Basic.html#Std.Iter\">Std.Iter</a> <a href=\"./Init/Prelude.html#Char\">Char</a></span></div></div>","info":{"doc":"Decodes the bytes of `it` in scheme `e`, stopping at the first ill-formed input. A byte order mark\nor signature of `e` at the start is skipped, and for `utf16 o` and `utf32 o` the mark tells the byte\norder; without one, the byte order is `o`.\n\nA `for` loop or fold over the result ends at ill-formed input just as at the end of the input. To\ntell them apart, fold with `decodeFold`, which also returns the iterator where decoding stopped, and\ncheck `decodeError?` there, find the first ill-formed input ahead with `decodeFailure?`, or decode\nwith `decodeIterLossy` instead.","docLink":"./UnicodeFormat/Iterator/EncodingScheme.html#Unicode.EncodingScheme.decodeIter","kind":"def","line":137,"name":"Unicode.EncodingScheme.decodeIter","sourceLink":"https://github.com/fgdorais/lean4-unicode-format/blob/929442f07486b2652bf358c2afa06a276eaab7cd/UnicodeFormat/Iterator/EncodingScheme.lean#L137-L150"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./UnicodeFormat/Iterator/EncodingScheme.html#Unicode.instEncoderEncodingSchemeCharUInt8\"><span class=\"name\">Unicode</span>.<span class=\"name\">instEncoderEncodingSchemeCharUInt8</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./UnicodeFormat/Iterator/Basic.html#Unicode.Encoder\">Encoder</a> <a href=\"./UnicodeFormat/EncodingScheme.html#Unicode.EncodingScheme\">EncodingScheme</a> <a href=\"./Init/Prelude.html#Char\">Char</a> <a href=\"./Init/Prelude.html#UInt8\">UInt8</a></span></div></div>","info":{"doc":"","docLink":"./UnicodeFormat/Iterator/EncodingScheme.html#Unicode.instEncoderEncodingSchemeCharUInt8","kind":"instance","line":104,"name":"Unicode.instEncoderEncodingSchemeCharUInt8","sourceLink":"https://github.com/fgdorais/lean4-unicode-format/blob/929442f07486b2652bf358c2afa06a276eaab7cd/UnicodeFormat/Iterator/EncodingScheme.lean#L104-L120"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">instance</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./UnicodeFormat/Iterator/EncodingScheme.html#Unicode.instDecoderEncodingSchemeUInt8Char\"><span class=\"name\">Unicode</span>.<span class=\"name\">instDecoderEncodingSchemeUInt8Char</span></a> </span><span class=\"decl_args\"> :</span><div class=\"decl_type\"><span class=\"fn\"><a href=\"./UnicodeFormat/Iterator/Basic.html#Unicode.Decoder\">Decoder</a> <a href=\"./UnicodeFormat/EncodingScheme.html#Unicode.EncodingScheme\">EncodingScheme</a> <a href=\"./Init/Prelude.html#UInt8\">UInt8</a> <a href=\"./Init/Prelude.html#Char\">Char</a></span></div></div>","info":{"doc":"","docLink":"./UnicodeFormat/Iterator/EncodingScheme.html#Unicode.instDecoderEncodingSchemeUInt8Char","kind":"instance","line":100,"name":"Unicode.instDecoderEncodingSchemeUInt8Char","sourceLink":"https://github.com/fgdorais/lean4-unicode-format/blob/929442f07486b2652bf358c2afa06a276eaab7cd/UnicodeFormat/Iterator/EncodingScheme.lean#L100-L102"}},{"header":"<div class=\"decl_header\"><span class=\"decl_kind\">def</span><span class=\"decl_name\"> <a class=\"break_within\" href=\"./UnicodeFormat/Iterator/EncodingScheme.html#Unicode.EncodingScheme.decodeChar\"><span class=\"name\">Unicode</span>.<span class=\"name\">EncodingScheme</span>.<span class=\"name\">decodeChar</span></a> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">ι</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Data/Iterators/Basic.html#Std.Iterator\">Std.Iterator</a> <span class=\"fn\">ι</span> <a href=\"./Init/Control/Id.html#Id\">Id</a> <a href=\"./Init/Prelude.html#UInt8\">UInt8</a></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">[<span class=\"fn\"><a href=\"./Init/Data/Iterators/Basic.html#Std.Iterators.Productive\">Std.Iterators.Productive</a> <span class=\"fn\">ι</span> <a href=\"./Init/Control/Id.html#Id\">Id</a></span>]</span></span> </span><span class=\"impl_arg\"><span class=\"decl_args\"><span class=\"fn\">{<span class=\"fn\">β</span> : <a href=\"./foundational_types.html\">Type</a>}</span></span> </span><span class=\"decl_args\"><span class=\"fn\">(<span class=\"fn\">e</span> : <a href=\"./Uni